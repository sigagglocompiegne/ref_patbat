CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_site()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	
	v_code_ref_id INT; --variable dans laquelle on stocke l'id de site du code de référence
BEGIN

-----------------------------------------------------------------------------------------
--                                      CONTROLES DE SAISIE                            --
-----------------------------------------------------------------------------------------

	-- test de superposition avec un autre site
	IF EXISTS (SELECT 1 FROM r_patbat.geo_patbat_site s 
				JOIN r_patbat.an_patbat_entite e ON s.id_entite = e.id_entite
				WHERE s.id_entite is distinct from NEW.id_entite  		
				AND e.dbstatut IS DISTINCT FROM '11' 
			    AND NEW.dbstatut IS DISTINCT FROM '11' 
				AND (ST_Intersects(NEW.geom,s.geom) and not ST_Touches(NEW.geom,s.geom))
				AND ST_Intersects(ST_Buffer(NEW.geom, -0.2), s.geom)) THEN -- Buffer négatif de 20cm
		RAISE EXCEPTION '<span style="color:red;"><b>Le site se superpose à un autre site actif</b></span><br><br>';
	END IF;

	-- test que le site est bien dans une seule commune 
	IF (SELECT count(*) FROM r_osm.geo_osm_commune c WHERE ST_Intersects(NEW.geom, c.geom) AND NOT ST_Touches(NEW.geom, c.geom)) > 1 THEN 
		RAISE EXCEPTION '<span style="color:red;"><b>Le site est compris dans 2 communes différentes</b></span><br><br>';
	END IF;

	-- test que le site a un nom d'usage, utilisé ensuite dans les niveaux du dessous pour récupérer un nom par défaut si aucun nom est rentré
	IF NEW.nom_usage is null and TG_OP != 'DELETE' then --protection au delete 
		raise exception '<span style="color:red;"><b>Le site doit au moins avoir un nom d''usage</b></span><br><br>';
	end if; 

-----------------------------------------------------------------------------------------
--                                    OPERATIONS                                       --
-----------------------------------------------------------------------------------------


	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN	

	-- calcul de l'id de site du code_ref 
	v_code_ref_id := nextval('r_patbat.patbat_site_seq');

        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite 
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert
        )
        VALUES (
            'Site', 'S' || v_code_ref_id , NEW.nom_usage, NEW.nom_officiel, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table geo_site, en utilisant le même id_entite
        INSERT INTO r_patbat.geo_patbat_site (id_entite, geom, supsite)
        VALUES (nouvel_id, NEW.geom, ROUND(ST_Area(NEW.geom)::numeric));

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN

		-- Si on change la géométrie du site, alors on teste si il existe un sous-site ou un bâtiment qui n'est plus compris dans le site dans lequel il était compris
		IF NEW.geom != old.geom and new.dbstatut = '10' then 
			-- Sous-site
			IF EXISTS (SELECT 1 FROM r_patbat.geo_patbat_ssite ss
						JOIN r_patbat.an_patbat_entite e ON e.id_entite = ss.id_entite 
						WHERE ss.id_site = NEW.id_entite and e.dbstatut = '10' and NOT ST_CoveredBy(ss.geom,NEW.geom)) then
			 RAISE EXCEPTION '<span style="color:red;"><b>Un sous-site n'' est plus compris dans un site</b></span><br><br>';
			END IF;
			-- Bati
			IF EXISTS (SELECT 1 FROM r_patbat.geo_patbat_bati b
						JOIN r_patbat.an_patbat_entite e ON e.id_entite = b.id_entite 
						WHERE b.id_site = NEW.id_entite and e.dbstatut = '10' and NOT ST_CoveredBy(b.geom,NEW.geom)) then
			 RAISE EXCEPTION '<span style="color:red;"><b>Un bâtiment n'' est plus compris dans un site</b></span><br><br>';
			END IF;
		end if; 

        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut, 
			op_maj = NEW.op_maj, 
			op_sai = NEW.op_sai,
			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.geo_patbat_site -- on update la table geo_site
        SET geom = NEW.geom,
		supsite = ROUND(ST_Area(NEW.geom)::numeric)
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN	-- si l'opération réalisée sur la vue est un DELETE	
		
		IF OLD.dbstatut = '11' THEN -- si le site est désactivé (dbstatut = '11') alors		
			DELETE FROM r_patbat.geo_v_patbat_ssite WHERE ST_CoveredBy(geom,OLD.geom); -- delete des sous-sites compris dans le site (si le sous-site est activé alors il devient désactivé)
			DELETE FROM r_patbat.geo_v_patbat_bati WHERE ST_CoveredBy(geom,OLD.geom); -- delete des bâtiments compris dans le site (si le bâtiment est activé alors il devient désactivé)

			DELETE FROM r_patbat.geo_patbat_site WHERE id_entite = OLD.id_entite; -- delete le site de la table geo_site
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete le site de la table entité

		ELSE -- si le site est activé (dbstatut = '10')

			DELETE FROM r_patbat.geo_v_patbat_ssite WHERE ST_CoveredBy(geom,OLD.geom) and dbstatut is distinct from '11' ; -- désactivation des sous-sites activés compris dans le site
			DELETE FROM r_patbat.geo_v_patbat_bati WHERE ST_CoveredBy(geom,OLD.geom) and dbstatut is distinct from '11' ; -- désactivation des bâtiments activés compris dans le site
			

			UPDATE r_patbat.an_patbat_entite -- on désactive le bâtiment (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;
     
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_site IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et site, par des opérations directement dans ces tables';

CREATE or replace TRIGGER t_t1_gestion_v_site
INSTEAD OF INSERT OR UPDATE OR DELETE ON r_patbat.geo_v_patbat_site
FOR EACH ROW EXECUTE FUNCTION r_patbat.ft_m_gestion_v_site();

COMMENT ON TRIGGER t_t1_gestion_v_site ON r_patbat.geo_v_patbat_site IS 'Trigger se déclanchant a l''insert, update, ou delete de la vue de regroupement de données entre les tables entité et site, appelant la fonction pour réaliser ces opérations directement dans les tables ';  

