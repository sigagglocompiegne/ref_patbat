drop schema if exists r_patbat;

create schema r_patbat;

create table r_patbat.geo_bati( -- sous-categorie, contacts, orga_roles en table de relations
	id_bati serial primary key,
	adresse varchar,
	categorie varchar,
	sous_categorie varchar,
	etat varchar,
	insee varchar,
	commune varchar,
	cadastre varchar,
	id_site varchar,
	id_ssite varchar
);

comment on table r_patbat.geo_bati is 'Classe géographique stockant les informations des bâtiments';
comment on column r_patbat.geo_bati.id_bati is 'Identifiant unique du bâtiment';

-- Table des fonctions de contacts (Liste de valeurs)
CREATE TABLE r_patbat.lt_fonction (
    code VARCHAR(10) PRIMARY KEY,
    valeur VARCHAR(100) NOT NULL
);

comment on table r_patbat.lt_fonction is 'Classe de liste de valeurs des focntions des contacts'
comment on column r_patbat.lt_fonction.code is 'Code de la fonction du contact';
comment on column r_patbat.lt_fonction.valeur is 'Valeur de la fonction du contact';

-- Table des contacts
CREATE TABLE r_patbat.an_contact (
    id_contact SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100),
    tel VARCHAR(20),
    email VARCHAR(150),
    organisme VARCHAR(100)
);

comment on table r_patbat.an_contact is 'Classe stockant les informations des contacts';
comment on column r_patbat.an_contact.id_contact is 'Identifiant unique du contact';
comment on column r_patbat.an_contact.nom is 'Nom du contact';
comment on column r_patbat.an_contact.prenom is 'Prenom du contact';
comment on column r_patbat.an_contact.tel is 'Numéro de téléphone du contact';
comment on column r_patbat.an_contact.email is 'Email du contact';
comment on column r_patbat.an_contact.organisme is 'Organisme du contact';

-- Table de relation entre les contacts et les fonctions de contacts 
CREATE TABLE r_patbat.lk_contact (
    id_batiment INT,
    id_contact INT,
    code_fonction VARCHAR,
    CONSTRAINT pk_lk_contact PRIMARY KEY (id_batiment, id_contact, code_fonction),
    CONSTRAINT fk_lk_contact_id_bat FOREIGN KEY (id_batiment) REFERENCES r_patbat.geo_bati(id_bati), 
    CONSTRAINT fk_lk_contact_id_cont FOREIGN KEY (id_contact) REFERENCES r_patbat.an_contact(id_contact), 
    CONSTRAINT fk_lk_contact_fonction FOREIGN KEY (code_fonction) REFERENCES r_patbat.lt_fonction(code)
);

comment on table r_patbat.lk_contact is 'Classe de relation entre les bâtiments, fonction des contacts, et informations des contacts';
comment on column r_patbat.lk_contact.id_batiment is 'Identifiant unique du bâtiment';
comment on column r_patbat.lk_contact.id_contact is 'Identifiant du contact';
comment on column r_patbat.lk_contact.code_fonction is 'Fonction du contact';
