CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_bati()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_id_site INT; -- l'id du site dans lequel est compris le bâtiment
	v_statut_site VARCHAR; --le statut du site dans lequel est compris le bâtiment
	v_nom_usage_site varchar; -- le nom d'usage du site dans lequel est compris le bâtiment 
	v_code_ref_site varchar; -- code de référence du site dans lequel est compris le bâtiment
	v_code_ref_id varchar; -- id du bati a utiliser dans le code_ref
	r RECORD; -- variable de boucle 
BEGIN

-----------------------------------------------------------------------------------------
--                                       CONTROLES DE SAISIE                           --
-----------------------------------------------------------------------------------------

	SELECT s.id_entite, e.dbstatut, e.nom_usage, e.ref_code INTO v_id_site, v_statut_site, v_nom_usage_site, v_code_ref_site -- on stocke l'id, le nom d'usage et le statut du site actif dans lequel est compris le bâtiment
		FROM r_patbat.geo_patbat_site s 
		JOIN r_patbat.an_patbat_entite e ON s.id_entite = e.id_entite
		WHERE ST_CoveredBy(NEW.geom, s.geom) and e.dbstatut = '10';

	-- on teste si le bâtiment est bien compris dans un site 
	IF TG_OP IN ('UPDATE','INSERT') AND v_id_site IS NULL THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Le bâtiment doit être compris dans un site</b></span><br><br>';
	END IF; 

	-- Vérification de la cohérence des statuts, impossible de mettre un bâtiment actif dans un site désactivé
	IF v_statut_site = '11' AND NEW.dbstatut != '11' THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Impossible d''insérer ou de rendre actif un bâtiment dans un site désactivé (dbstatut = 11)</b></span><br><br>';
	END IF;

	-- on vérifie si le bâtiment actif ne se superpose pas avec un autre bâtiment actif
	IF EXISTS(SELECT 1 FROM r_patbat.geo_patbat_bati b 
			  JOIN r_patbat.an_patbat_entite e ON b.id_entite = e.id_entite
			  WHERE b.id_entite is distinct from NEW.id_entite 
			  AND e.dbstatut IS DISTINCT FROM '11' 
			  AND NEW.dbstatut IS DISTINCT FROM '11' 
              and (ST_Intersects(NEW.geom,b.geom) and not ST_Touches(NEW.geom,b.geom))) THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Le bâtiment se superpose avec un autre</b></span><br><br>';
	END IF;

-----------------------------------------------------------------------------------------
--                                    OPERATIONS                                       --
-----------------------------------------------------------------------------------------

	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN

		UPDATE r_patbat.geo_patbat_site
    	SET nb_bati = nb_bati + 1 
    	WHERE id_entite = v_id_site
    	RETURNING nb_bati INTO v_code_ref_id;

		-- si le bâtiment n'a pas de nom, on reprend le nom du site, et on y ajoute Bâtiment sans nom 
		IF NEW.nom_usage is null then 
			NEW.nom_usage := v_nom_usage_site || ' - Batiment sans nom' ;
		end if; 		

        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert
        )
        VALUES (
            'Bâtiment', v_code_ref_site || '-B' || v_code_ref_id , NEW.nom_usage, NEW.nom_officiel, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table geo_bati, en utilisant le même id_entite et le v_id_site récupéré
        INSERT INTO r_patbat.geo_patbat_bati (id_entite, geom, etat, id_site,supsol,supdvp,nb_etage)
        VALUES (nouvel_id, NEW.geom, NEW.etat, v_id_site,ROUND(ST_Area(NEW.geom)::numeric),NEW.supdvp,NEW.nb_etage);
  
		-- On lance la fonction de calcul de total surface sol des bâtimetns dans un sous-site pour tout les sous-sites dans lequel est compris le bâtiment
		FOR r IN (SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(NEW.geom, geom)) LOOP
            PERFORM r_patbat.ft_r_maj_supsol_ssite(r.id_entite); 
        END LOOP;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut, 
			op_maj = NEW.op_maj,
 			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.geo_patbat_bati -- on update la table geo_bati
        SET geom = NEW.geom, 
		etat = NEW.etat,
		supsol = ROUND(ST_Area(NEW.geom)::numeric),
		supdvp = NEW.supdvp,
		nb_etage = NEW.nb_etage
        WHERE id_entite = OLD.id_entite;

		-- on recalcule le total surface sol des bâtimetns dans l'ancien sous-site ou se trouvait le bâtiment, ainsi que dans le nouveau
		FOR r IN (
            SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(NEW.geom, geom)
            UNION
            SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(OLD.geom, geom)
        ) LOOP
            PERFORM r_patbat.ft_r_maj_supsol_ssite(r.id_entite); 
        END LOOP;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '11' THEN -- si le bâtiment est désactivé (dbstatut = '11') alors
			DELETE FROM r_patbat.geo_patbat_bati WHERE id_entite = OLD.id_entite; -- delete le bâtiment de la table geo_bati
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete le bâtiment de la table entité
		
		ELSE -- si le bâtiment est activé (dbstatut = '10')
			UPDATE r_patbat.an_patbat_entite -- on désactive le bâtiment (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;

		--on recalcule le total surface sol des bâtimetns dans l'ancien sous-site ou se trouvait le bâtiment 
		FOR r IN (SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(OLD.geom, geom)) LOOP
            PERFORM r_patbat.ft_r_maj_supsol_ssite(r.id_entite);
        END LOOP;
    END IF;


	-- mise à jour de la supsol et supdvp du site, en additionnant les supsols et supdvps des bâitments actifs compris dans le site
		UPDATE r_patbat.geo_patbat_site
		SET supsol_tot_bati = (
			SELECT SUM(b.supsol) 
			FROM r_patbat.geo_patbat_bati b 
			JOIN r_patbat.an_patbat_entite e ON b.id_entite = e.id_entite 
			WHERE b.id_site = v_id_site AND e.dbstatut = '10'
		),
		supdvp_tot_bati = (
			SELECT SUM(b.supdvp) 
			FROM r_patbat.geo_patbat_bati b 
			JOIN r_patbat.an_patbat_entite e ON b.id_entite = e.id_entite 
			WHERE b.id_site = v_id_site AND e.dbstatut = '10'
		)
		WHERE id_entite = v_id_site;


		IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    ELSE
        RETURN NEW;
    END IF;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_bati IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et bâtiment, par des opérations directement dans ces tables';

