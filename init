-- fonction de nettoyage par rapport a QGIS 
CREATE OR REPLACE FUNCTION r_patbat.ft_r_nettoyage_qgis_multiselect()
RETURNS TRIGGER AS $$
BEGIN
    -- Si le champ contient des données, on efface les accolades et guillemets, et on change la virgule en point-virgule
    IF NEW.type_etablissement IS NOT NULL THEN
        NEW.type_etablissement := replace(translate(NEW.type_etablissement, '{}""', ''), ',', ';');
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

