--                                       SITE                                          --
-----------------------------------------------------------------------------------------


create or replace view r_patbat.geo_v_patbat_site as 
	select e.ref_code,
	e.id_entite,
	e.nom_court,
	e.nom_long,
	e.superficie,
	e.surface,
	e.categorie,
	e.observ,
	e.type_etablissement,
	s.geom
	from r_patbat.an_entite e
 	join r_patbat.geo_site s on e.id_entite = s.id_entite;

COMMENT ON VIEW r_patbat.geo_v_patbat_site IS 'Vue regroupant les attrbuts de la table entité ainsi que la géométrie de la table site';

CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_site()
RETURNS TRIGGER AS $$
DECLARE
    -- Déclaration de la variable pour stocker l'ID généré
    nouvel_id INT;
BEGIN

	-- test pour savoir si le site n'est pas superposé à un autre 
	IF EXISTS (SELECT 1 FROM r_patbat.geo_site s WHERE (ST_Intersects(NEW.geom,s.geom) and not ST_Touches(NEW.geom,s.geom))) THEN 
		RAISE EXCEPTION 'Le site se superpose à un autre';
	END IF;

    -- ==========================================
    -- CAS 1 : INSERTION (Création d'un site)
    -- ==========================================
    IF TG_OP = 'INSERT' THEN
        -- 1. Insertion dans la table entite avec récupération de l'ID
        INSERT INTO r_patbat.an_entite (
            type_entite,ref_code, nom_court, nom_long, superficie, surface, categorie, observ, type_etablissement
        )
        VALUES (
            'Site',NEW.ref_code, NEW.nom_court, NEW.nom_long, NEW.superficie,NEW.surface, NEW.categorie, NEW.observ, NEW.type_etablissement
        )
        RETURNING id_entite INTO nouvel_id; -- On met l'id_entite crée automatiquement dans nouvel_id

        -- 2. Insertion dans la table site avec l'ID stocké dans la variable
        INSERT INTO r_patbat.geo_site (id_entite, geom)
        VALUES (nouvel_id, NEW.geom);

        RETURN NEW;

    -- ==========================================
    -- CAS 2 : MISE À JOUR (Modification)
    -- ==========================================
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_entite
        SET ref_code = NEW.ref_code,
            nom_court = NEW.nom_court,
            nom_long = NEW.nom_long,
            superficie = NEW.superficie,
			surface = NEW.surface,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.geo_site
        SET geom = NEW.geom
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

    -- ==========================================
    -- CAS 3 : SUPPRESSION
    -- ==========================================
    ELSIF TG_OP = 'DELETE' THEN
        DELETE FROM r_patbat.an_entite WHERE id_entite = OLD.id_entite;
        RETURN OLD;
    END IF;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_site IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et site, par des opérations directement dans ces tables';

CREATE or replace TRIGGER t_t1_gestion_v_site
INSTEAD OF INSERT OR UPDATE OR DELETE ON r_patbat.geo_v_patbat_site
FOR EACH ROW EXECUTE FUNCTION r_patbat.ft_m_gestion_v_site();

COMMENT ON TRIGGER t_t1_gestion_v_site ON r_patbat.geo_v_patbat_site IS 'Trigger se déclanchant a l''insert, update, ou delete de la vue de regroupement de données entre les tables entité et site, appelant la fonction pour réaliser ces opérations directement dans les tables ';  

