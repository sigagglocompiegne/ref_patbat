CREATE OR REPLACE VIEW r_patbat.geo_v_patbat_site AS
	SELECT e.ref_code,
		e.id_entite,
		e.nom_usage,
		e.nom_officiel,
		e.categorie,
		e.observ,
		e.type_etablissement,
		e.dbstatut,
		s.supsite,
		s.supsol_tot_bati,
		s.supdvp_tot_bati,
		s.supdvp_tot_mesuree,
		e.op_sai,
		e.op_maj,
		e.dbinsert,
		e.dbupdate,
		e.insee,
		e.commune,
		e.parcelles,
		s.geom
	FROM r_patbat.an_patbat_entite e
	JOIN r_patbat.geo_patbat_site s ON e.id_entite = s.id_entite;

