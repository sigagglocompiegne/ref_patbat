CREATE OR REPLACE FUNCTION r_patbat.ft_r_verif_type_pdl()
RETURNS TRIGGER AS $$
begin
	-- si le pdl est un compteur parent lui même mais qu'un compteur parent est rempli
	IF NEW.type_compteur = '10' and NEW.compteur_parent is not null then 
		RAISE EXCEPTION '<span style="color:red;"><b>Un compteur principal ne peut pas avoir de compteur parent.</b></span><br><br>';
	-- si le pdl est un sous-compteur mais qu'aucun compteur parent n'est rempli
	ELSIF NEW.type_compteur = '20' and NEW.compteur_parent is null then 
		RAISE EXCEPTION '<span style="color:red;"><b>Un sous-compteur doit avoir un compteur parent.</b></span><br><br>';
	end if; 
	RETURN NEW;

end;
$$ language plpgsql; 

COMMENT ON FUNCTION r_patbat.ft_r_verif_type_pdl() IS 'Fonction test afin de détecter les erreurs de saisie potentielles pour les pdl';

