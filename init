COMMENT ON VIEW r_patbat.geo_v_patbat_unite_fonc IS 'Vue regroupant les attrbuts de la table entité ainsi que ceux de la table d''unité fonctionnelle';


CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_unite_fonc()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_statut_bati VARCHAR; -- l'id du bâtiment dans lequel se trouve l'UF
	v_nom_bati varchar; -- le nom court du bâti dans lequel se trouve l'unité fonctionnelle
	v_insee_bati varchar; --le code insee du bâti dans lequel se trouve l'unité fonctionnelle
	v_commune_bati varchar; -- le nom de la commune du bâti dans lequel se trouve l'unité fonctionnelle 
BEGIN
	
	SELECT dbstatut, nom_usage, insee, commune INTO v_statut_bati, v_nom_bati, v_insee_bati, v_commune_bati -- on va chercher le statut et le nom du bâtiment dans lequel se trouve l'unité fonctionnelle
	FROM r_patbat.an_patbat_entite 
	WHERE id_entite = NEW.id_bati;

	-- sécurité bâtiment
	IF v_statut_bati is null then 
	raise exception 'Erreur : Le bâtiment est introuvable ou pas encore créé';
	end if; 

	-- Vérification de la cohérence des statuts, impossible de mettre une UF active dans un site désactivé
	IF v_statut_bati = '11' AND NEW.dbstatut != '11' THEN
		RAISE EXCEPTION 'Impossible d''insérer ou de rendre actif une unité fonctionnelle dans un site désactivé (dbstatut = 11)';
	END IF;

	-- si l'UF n'a pas de nom, alors on utilse le nom du bâtiment auquel on y rajouter Unité fonctionnelle sans nom
	IF NEW.nom_usage is null then
		NEW.nom_usage := v_nom_bati || ' - Unité fonctionnelle sans nom';
	end if;  

	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN
        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert, insee, commune 
        )
        VALUES (
            'Unité',NEW.ref_code, NEW.nom_usage, NEW.nom_officiel, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP, v_insee_bati, v_commune_bati
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table an_unite_fonc, en utilisant le même id_entite
        INSERT INTO r_patbat.an_patbat_unite_fonc (id_entite, id_bati, supdvp)
        VALUES (nouvel_id, NEW.id_bati, NEW.supdvp);

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut,
 			op_maj = NEW.op_maj, 
			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.an_patbat_unite_fonc -- on update la table an_unite_fonc
        SET id_bati = NEW.id_bati,
		supdvp = NEW.supdvp
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '11' THEN -- si l'unité fonctionnelle est désactivée (dbstatut = '11') alors
			DELETE FROM r_patbat.an_patbat_unite_fonc WHERE id_entite = OLD.id_entite; -- delete l'unité fonctionnelle de la table an_unite_fonc
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete l'unité fonctionnelle de la table entité
		
		ELSE -- si l'unité fonctionnelle est activée (dbstatut = '10')
			UPDATE r_patbat.an_patbat_entite -- on désactive l'unité fonctionnelle (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;
        
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_unite_fonc IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et unité fonctionnelle, par des opérations directement dans ces tables';


CREATE or replace TRIGGER t_t1_gestion_v_unite_fonc
INSTEAD OF INSERT OR UPDATE OR DELETE ON r_patbat.geo_v_patbat_unite_fonc
FOR EACH ROW EXECUTE FUNCTION r_patbat.ft_m_gestion_v_unite_fonc();

COMMENT ON TRIGGER t_t1_gestion_v_unite_fonc ON r_patbat.geo_v_patbat_unite_fonc IS 'Trigger se déclanchant a l''insert, update, ou delete de la vue de regroupement de données entre les tables entité et unité fonctionnelle, appelant la fonction pour réaliser ces opérations directement dans les tables ';


