CREATE TRIGGER t_nettoyage_qgis_multiselect
BEFORE INSERT OR UPDATE ON r_patbat.an_patbat_entite
FOR EACH ROW
EXECUTE FUNCTION r_patbat.ft_r_nettoyage_qgis_multiselect();

