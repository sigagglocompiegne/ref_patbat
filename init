COMMENT ON COLUMN r_patbat.an_v_patbat_local.dbupdate IS 'Date de mise à jour du local';

CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_local()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_statut_uf VARCHAR; --le statut de l'uf dans laquelle se trouve le local
	v_nom_uf varchar;--le nom de l'uf dans laquelle se trouve le local
	v_insee_uf varchar; --le code insee du bâti dans lequel se trouve l'unité fonctionnelle
	v_commune_uf varchar; -- le nom de la commune du bâti dans lequel se trouve l'unité fonctionnelle 
	v_code_ref_uf varchar; -- le code de référence de l'uf dans lequel se trouve le local 
	v_code_ref_id varchar; -- l'identifiant du local a utiliser dans le code_ref
	v_id_bati int; -- l'idetifian du bâtiment dans lequel se trouve le code ref
BEGIN
	
-----------------------------------------------------------------------------------------
--                                       CONTROLES DE SAISIE                           --
-----------------------------------------------------------------------------------------

	SELECT dbstatut, nom_usage, insee, commune, ref_code INTO v_statut_uf, v_nom_uf, v_insee_uf, v_commune_uf, v_code_ref_uf -- onstocke le statut de l'uf dans laquelle se trouve le local
	FROM r_patbat.an_patbat_entite 
	WHERE id_entite = NEW.id_uf;

	-- sécurité uf 
	IF TG_OP IN ('UPDATE','INSERT') and v_statut_uf is null then 
	raise exception '<span style="color:red;"><b>L''unité fonctionnelle est introuvable</b></span><br><br>';
	end if;

	-- Vérification de la cohérence des statuts, impossible de mettre un local dans un site désactivé
	IF v_statut_uf = '11' AND NEW.dbstatut != '11' THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Impossible d''insérer ou de rendre actif un local dans une unité fonctionnelle désactivée (dbstatut = 11)</b></span><br><br>';
	END IF;

	IF NEW.nom_usage is null then 
		NEW.nom_usage := v_nom_uf || ' - Local sans nom';
	END IF;

	-- si la supdvp est NULL mais que supdvp_mesuree set cochée alors on interdit la saisie car impossible
	IF (NEW.supdvp is null or NEW.supdvp = 0 ) AND NEW.supdvp_mesuree = True then 
		RAISE EXCEPTION '<span style="color:red;"><b>Si la surface développée est mesurée, elle ne peut être égale à 0 ou nulle</b></span><br><br>';
	end if; 

-----------------------------------------------------------------------------------------
--                                    OPERATIONS                                       --
-----------------------------------------------------------------------------------------


	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN

		UPDATE r_patbat.an_patbat_unite_fonc
    	SET nb_local = nb_local + 1
   		WHERE id_entite = NEW.id_uf
    	RETURNING nb_local INTO v_code_ref_id;

        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert, insee, commune
        )
        VALUES (
            'Local',v_code_ref_uf || '-L' || v_code_ref_id , NEW.nom_usage, NEW.nom_officiel,  NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP, v_insee_uf, v_commune_uf
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table an_local, en utilisant le même id_entite
        INSERT INTO r_patbat.an_patbat_local (id_entite, id_uf, supdvp, supdvp_mesuree)
        VALUES (nouvel_id, NEW.id_uf, NEW.supdvp, NEW.supdvp_mesuree);

		-- On insère les liens entre local et uf/bati/ssite/site dans les tables de lien
		-- 1. Lien direct : UF <-> Local
		INSERT INTO r_patbat.lk_patbat_uf_local (id_uf, id_local)
		VALUES (NEW.id_uf, nouvel_id);

		-- On récupère l'ID du Bâtiment parent de l'UF pour faire les liaisons du dessus
		SELECT id_bati INTO v_id_bati 
		FROM r_patbat.lk_patbat_bati_uf 
		WHERE id_uf = NEW.id_uf ;

		-- 2. Lien hérité : Bâtiment <-> Local
		INSERT INTO r_patbat.lk_patbat_bati_local (id_bati, id_local)
		VALUES (v_id_bati, nouvel_id);

		-- 3. Lien hérité : Site <-> Local
		-- on crée un lien entre le local, et le site ou est compris le bâtiment dans lequel est le local
		INSERT INTO r_patbat.lk_patbat_site_local (id_site, id_local)
		SELECT id_site, nouvel_id 
		FROM r_patbat.lk_patbat_site_bati 
		WHERE id_bati = v_id_bati;

		-- 4. Lien hérité : Sous-site(s) <-> Local
		-- on crée un lien entre le local,et chaque sous-site ou le bâtiment dans lequel est le local est compris
		INSERT INTO r_patbat.lk_patbat_ssite_local (id_ssite, id_local)
		SELECT id_ssite, nouvel_id 
		FROM r_patbat.lk_patbat_ssite_bati 
		WHERE id_bati = v_id_bati;

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut, 
			op_maj = NEW.op_maj,
 			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.an_patbat_local -- on update la table an_local
        SET id_uf = NEW.id_uf,
			supdvp = NEW.supdvp,
			supdvp_mesuree = NEW.supdvp_mesuree
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '11' THEN -- si le local est désactivé (dbstatut = '11') alors
			DELETE FROM r_patbat.an_patbat_local WHERE id_entite = OLD.id_entite; -- delete le local de la table an_local
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete le local de la table entité
		
		ELSE -- si le local est activée (dbstatut = '10')
			UPDATE r_patbat.an_patbat_entite -- on désactive le local (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;
        
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_local IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et local, par des opérations directement dans ces tables';


