create or replace view r_patbat.geo_v_patbat_ssite as 
	select e.ref_code,
	e.id_entite,
	e.nom_usage,
	e.nom_officiel,
	e.categorie,
	e.observ,
	e.type_etablissement,
	e.dbstatut,
	ss.geom,
	ss.supsol,
	e.op_sai,
	e.op_maj,
	e.dbinsert,
	e.dbupdate
	from r_patbat.an_patbat_entite e
 	join r_patbat.geo_patbat_ssite ss on e.id_entite = ss.id_entite;

COMMENT ON VIEW r_patbat.geo_v_patbat_ssite IS 'Vue regroupant les attrbuts de la table entité ainsi que la géométrie de la table sous-site';

CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_ssite()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_id_site INT; -- l'id du site dans lequel est compris le sous-site
	v_statut_site VARCHAR; --le statut du site dans lequel est compris le sous-site
BEGIN

	SELECT s.id_entite, e.dbstatut INTO v_id_site, v_statut_site -- on stocke l'id et le staut du site actif dans lequel est compris le sous-site
	FROM r_patbat.geo_patbat_site s 
	JOIN r_patbat.an_patbat_entite e ON s.id_entite = e.id_entite
	WHERE ST_CoveredBy(NEW.geom, s.geom) and e.dbstatut = '10' ;

	-- on teste si le sous-site est bien compris dans un site 
    IF TG_OP IN ('UPDATE','INSERT') AND v_id_site IS NULL THEN 
		RAISE EXCEPTION 'Le sous-site n''est pas compris dans un site';
	END IF;

	-- Vérification de la cohérence des statuts, impossible de mettre un sous-site actif dans un site désactivé
	IF v_statut_site = '11' AND NEW.dbstatut != '11' THEN
		RAISE EXCEPTION 'Impossible d''insérer ou de rendre actif un sous-site dans un site désactivé (dbstatut = 11)';
	END IF;

	-- on vérifie si le sous-site actif ne se superpose pas avec un autre sous-site actif
	IF EXISTS(SELECT 1 FROM r_patbat.geo_patbat_ssite ss 
			  JOIN r_patbat.an_patbat_entite e ON ss.id_entite = e.id_entite
			  WHERE ss.id_entite is distinct from NEW.id_entite 
			  AND e.dbstatut IS DISTINCT FROM '11' 
			  AND NEW.dbstatut IS DISTINCT FROM '11'  
			  and (ST_Intersects(NEW.geom,ss.geom) and not ST_Touches(NEW.geom,ss.geom))) THEN
		RAISE EXCEPTION 'Le sous-site se superpose avec un autre sous-site';
	END IF;  

	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN
        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert
        )
        VALUES (
            'Sous-Site',NEW.ref_code, NEW.nom_usage, NEW.nom_officiel, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table .geo_patbat_ssite, en utilisant le même id_entite et le v_id_site récupéré
        INSERT INTO r_patbat.geo_patbat_ssite (id_entite, geom, id_site, supsol)
        VALUES (nouvel_id, NEW.geom, v_id_site, ROUND(ST_Area(NEW.geom)::numeric) );

		-- On lance la fonction de calcul du total de la superficie au sol des bâtiments compris dans le sous-site
		PERFORM r_patbat.ft_r_maj_supsol_ssite(nouvel_id);

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut,
 			op_maj = NEW.op_maj,
 			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.geo_patbat_ssite -- on update la table .geo_patbat_ssite
        SET geom = NEW.geom,
		supsol = ROUND(ST_Area(NEW.geom)::numeric)
        WHERE id_entite = OLD.id_entite;

		-- On lance la fonction de calcul du total de la superficie au sol des bâtiments compris dans le sous-site
		PERFORM r_patbat.ft_r_maj_supsol_ssite(NEW.id_entite);

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '11' THEN -- si le sous-site est désactivé (dbstatut = '11') alors
			DELETE FROM r_patbat.geo_patbat_ssite WHERE id_entite = OLD.id_entite; -- delete le sous-site de la table .geo_patbat_ssite
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete le sous-site de la table entité
		
		ELSE -- si le sous-site est activé (dbstatut = '10' ou '1')
			UPDATE r_patbat.an_patbat_entite -- on désactive le sous-site (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;
        
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_ssite IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et sous-site, par des opérations directement dans ces tables';


CREATE or replace TRIGGER t_t1_gestion_v_ssite
INSTEAD OF INSERT OR UPDATE OR DELETE ON r_patbat.geo_v_patbat_ssite
FOR EACH ROW EXECUTE FUNCTION r_patbat.ft_m_gestion_v_ssite();

COMMENT ON TRIGGER t_t1_gestion_v_ssite ON r_patbat.geo_v_patbat_ssite IS 'Trigger se déclanchant a l''insert, update, ou delete de la vue de regroupement de données entre les tables entité et sous-site, appelant la fonction pour réaliser ces opérations directement dans les tables ';  


