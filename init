-----------------------------------------------------------------------------------------
--                                       SITE                                          --
-----------------------------------------------------------------------------------------

create or replace view r_patbat.geo_v_patbat_site as 
	select e.ref_code,
	e.id_entite,
	e.nom_court,
	e.nom_long,
	e.superficie,
	e.surface,
	e.categorie,
	e.observ,
	e.type_etablissement,
	e.dbstatut,
	s.geom
	from r_patbat.an_entite e
 	join r_patbat.geo_site s on e.id_entite = s.id_entite;

COMMENT ON VIEW r_patbat.geo_v_patbat_site IS 'Vue regroupant les attributs de la table entité ainsi que la géométrie de la table site';

CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_site()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
BEGIN
	-- test de superposition avec un autre site
	IF EXISTS (SELECT 1 FROM r_patbat.geo_site s 
				JOIN r_patbat.an_entite e ON s.id_entite = e.id_entite
				WHERE s.id_entite is distinct from NEW.id_entite  		
				AND e.dbstatut IS DISTINCT FROM '20' 
			    AND NEW.dbstatut IS DISTINCT FROM '20' 
				AND (ST_Intersects(NEW.geom,s.geom) and not ST_Touches(NEW.geom,s.geom))) THEN 
		RAISE EXCEPTION 'Le site se superpose à un autre site actif';
	END IF;

	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN
        INSERT INTO r_patbat.an_entite ( -- on insère les données de la vue dans la table an_entite 
            type_entite,ref_code, nom_court, nom_long, superficie, surface, categorie, observ, type_etablissement, dbstatut
        )
        VALUES (
            'Site',NEW.ref_code, NEW.nom_court, NEW.nom_long, NEW.superficie,NEW.surface, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table geo_site, en utilisant le même id_entite
        INSERT INTO r_patbat.geo_site (id_entite, geom)
        VALUES (nouvel_id, NEW.geom);

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_court = NEW.nom_court,
            nom_long = NEW.nom_long,
            superficie = NEW.superficie,
			surface = NEW.surface,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.geo_site -- on update la table geo_site
        SET geom = NEW.geom
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN	-- si l'opération réalisée sur la vue est un DELETE	
		
		IF OLD.dbstatut = '20' THEN -- si le site est désactivé (dbstatut = '20') alors		
			DELETE FROM r_patbat.geo_v_patbat_ssite WHERE ST_CoveredBy(geom,OLD.geom); -- delete des sous-sites compris dans le site (si le sous-site est activé alors il devient désactivé)
			DELETE FROM r_patbat.geo_v_patbat_bati WHERE ST_CoveredBy(geom,OLD.geom); -- delete des bâtiments compris dans le site (si le bâtiment est activé alors il devient désactivé)
		
	

			DELETE FROM r_patbat.geo_site WHERE id_entite = OLD.id_entite; -- delete le site de la table geo_site
        	DELETE FROM r_patbat.an_entite WHERE id_entite = OLD.id_entite; -- delete le site de la table entité

		ELSE -- si le site est activé (dbstatut = '10')

			DELETE FROM r_patbat.geo_v_patbat_ssite WHERE ST_CoveredBy(geom,OLD.geom) and dbstatut is distinct from '20' ; -- désactivation des sous-sites activés compris dans le site
			DELETE FROM r_patbat.geo_v_patbat_bati WHERE ST_CoveredBy(geom,OLD.geom) and dbstatut is distinct from '20' ; -- désactivation des bâtiments activés compris dans le site
			

			UPDATE r_patbat.an_entite -- on désactive le bâtiment (dbstatut = '20')
			SET dbstatut = '20' 
			WHERE id_entite = OLD.id_entite;
		END IF;
     
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_site IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et site, par des opérations directement dans ces tables';

CREATE or replace TRIGGER t_t1_gestion_v_site
INSTEAD OF INSERT OR UPDATE OR DELETE ON r_patbat.geo_v_patbat_site
FOR EACH ROW EXECUTE FUNCTION r_patbat.ft_m_gestion_v_site();

COMMENT ON TRIGGER t_t1_gestion_v_site ON r_patbat.geo_v_patbat_site IS 'Trigger se déclanchant a l''insert, update, ou delete de la vue de regroupement de données entre les tables entité et site, appelant la fonction pour réaliser ces opérations directement dans les tables ';  

