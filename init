CREATE OR REPLACE FUNCTION ft_r_parcelles()
RETURNS TRIGGER AS $$
BEGIN
    -- Mise à jour de la table entité avec un texte contenant toutes les parcelles intersectées, séparées par un ;
    UPDATE r_patbat.an_patbat_entite  
    SET parcelles = ( 
        SELECT string_agg(geo_parcelle, ';') 
        FROM r_cadastre.geo_parcelle p 
        WHERE ST_Intersects(NEW.geom, p.geom) and not ST_Touches (NEW.geom, p.geom)
    )
    WHERE id_entite = NEW.id_entite;
    
    RETURN NEW; 
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION ft_r_parcelles IS 'Fonction récupérant un tableau contenant les numéros de parcelles cadastrales dans lesquelles se trouvent l''entité';

