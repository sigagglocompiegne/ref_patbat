CREATE OR REPLACE FUNCTION r_patbat.ft_m_verif_unique_contact()
RETURNS TRIGGER AS $$ 
BEGIN 
	IF EXISTS(SELECT 1 FROM r_patbat.lk_patbat_contact WHERE id_contact = NEW.id_contact and id_entite = NEW.id_entite and code_fonction = NEW.code_fonction AND gid IS DISTINCT FROM NEW.gid) THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Ce contact est déjà affecté à cette entité avec cette même fonction.</b></span><br><br>';
	END IF;
	return new;
END;
$$ LANGUAGE plpgsql; 

COMMENT ON FUNCTION r_patbat.ft_m_verif_unique_contact IS 'Fonction test afin de garantir l''unicité des valeurs de la table de lien entre les contacts et les entités';

