create table r_patbat.an_patbat_entite( -- sous-categorie, contacts, orga_roles, pièces jointes, adresses en table de relations
	id_entite serial primary key,
	niveau varchar(20), -- site, UF, | table de valeur 
	ref_code varchar(50),
	nom_usage varchar(100) NOT NULL,
	nom_officiel varchar(100),
	categorie varchar(50) NOT NULL, --talbe de valeur
	type_etablissement VARCHAR(50), -- Contiendra 'ERP','ERT' ou 'ERP;ERT'
    parcelles text,           -- Contiendra les IDs des parcelles, ex: '000AB01';'000AB02'
	insee varchar(5), -- lien r_osm.geo_vm_osm_commune_arc
	commune varchar(80), -- lien r_osm.geo_vm_osm_commune_arc
	observ text,
	op_sai varchar(50),
	op_maj varchar(50),
	dbinsert timestamp with time zone,
	dbupdate timestamp with time zone,
	dbstatut VARCHAR(2) NOT NULL DEFAULT '10' CHECK (dbstatut IN ('10', '11')),
	
	constraint an_entite_categorie_fkey foreign key(categorie) references r_patbat.lt_patbat_categorie(code),
	CONSTRAINT an_entite_niveau_fkey FOREIGN key(niveau) REFERENCES r_patbat.lt_patbat_niveau(valeur)
);
comment on table r_patbat.an_patbat_entite is 'Classe attributaire regroupant les informations de toutes les entités du référentiel patrimoine bâtiment';
comment on column r_patbat.an_patbat_entite.id_entite is 'Identifiant unique de l''entité ';
COMMENT ON COLUMN r_patbat.an_patbat_entite.niveau IS 'Nom du niveau de l''entité : Site, Sous-site, Bâtiment, Unité, Local' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.ref_code IS 'Code de référence de l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.nom_usage IS 'Nom d''usage de l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.nom_officiel IS 'Nom officiel de l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.categorie IS 'Catégorie principale de l''entité';
COMMENT ON COLUMN r_patbat.an_patbat_entite.type_etablissement IS 'Types d''établisssement de l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.parcelles IS 'Numéros parcellaires sur lesquels se trouve l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.insee IS 'Code insee de la commune dans laquelle se trouve l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.commune IS 'Nom de la commune dans laquelle se trouve l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.observ IS 'Commentaires divers' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.op_sai IS 'Login de la personne ayant inséré les données' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.op_maj IS 'Login de la personne ayant modifié les données' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.dbinsert IS 'Date d''insertion de l''entité ' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.dbupdate IS 'Date de mise à jour de l''entité' ;
COMMENT ON COLUMN r_patbat.an_patbat_entite.dbstatut IS 'Statut de l''entité, gestion corbeille' ;

create table r_patbat.geo_patbat_site(
	id_entite int4 primary key,
	supsite int4 NOT NULL,
	supsol_tot_bati int4,
	supdvp_tot_bati int4,
	supdvp_tot_mesuree boolean DEFAULT FALSE,
	nb_bati int2 DEFAULT 0,
	nb_ssite int2 DEFAULT 0,
	geom geometry(MultiPolygon, 2154),
	
	constraint geo_site_entite_fkey foreign key (id_entite) references r_patbat.an_patbat_entite(id_entite)
);
comment on table r_patbat.geo_patbat_site is 'Classe géographique regroupant les informations de toutes les entités étant des sites';
comment on column r_patbat.geo_patbat_site.id_entite is 'Identifiant de l''entité';
comment on column r_patbat.geo_patbat_site.geom is 'Géométrie du site';
comment on column r_patbat.geo_patbat_site.supsite is 'Superficie du site, champ calculé auto à l''insert ';
comment on column r_patbat.geo_patbat_site.supsol_tot_bati is 'Calculé du total de la superficie au sol des bâtiments compris dans le site';
comment on column r_patbat.geo_patbat_site.supdvp_tot_bati is 'Calculé du total de la superficie développée des bâtiments compris dans le site';
COMMENT ON COLUMN r_patbat.geo_patbat_site.nb_bati IS 'Nombre de bâtiments compris dans le site, augmenté automatiquement';
COMMENT ON COLUMN r_patbat.geo_patbat_site.nb_ssite IS 'Nombre de sous-sites compris dans le site, augmenté automatiquement';


create table r_patbat.geo_patbat_ssite(
	id_entite int4 primary key,
	id_site int4 NOT NULL,
	supsite int4 NOT NULL,
	supsol_tot_bati int4,	
	geom geometry(MultiPolygon, 2154),
	
	constraint geo_patbat_ssite_entite_fkey foreign key (id_entite) references r_patbat.an_patbat_entite(id_entite),
	constraint geo_patbat_ssite_site_fkey foreign key (id_site) references r_patbat.geo_patbat_site(id_entite)
);
comment on table r_patbat.geo_patbat_ssite is 'Classe géographique regroupant les informations de toutes les entités étant des sous-sites';
comment on column r_patbat.geo_patbat_ssite.id_entite is 'Identifiant de l''entité';
comment on column r_patbat.geo_patbat_ssite.id_site is 'Identifiant du site dans lequel est compris le sous-site';
comment on column r_patbat.geo_patbat_ssite.geom is 'Géométrie du sous-site';
comment on column r_patbat.geo_patbat_ssite.supsite is 'Superficie du sous-site, champ calculé auto à l''insert ';
comment on column r_patbat.geo_patbat_ssite.supsol_tot_bati is 'Calculé du total de la superficie au sol des bâtiments compris dans le sous-site';


create table r_patbat.geo_patbat_bati(
	id_entite int4 primary key,
