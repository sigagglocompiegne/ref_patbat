CREATE FUNCTION r_patbat.ft_m_dbupdate_dbinsert()
RETURNS TRIGGER AS $$ 
BEGIN
	IF TG_OP = 'INSERT' THEN 
		NEW.dbinsert = CURRENT_TIMESTAMP;
	ELSIF TG_OP = 'UPDATE' then 
		NEW.dbupdate = CURRENT_TIMESTAMP;
	END IF;
	RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION  r_patbat.ft_m_dbupdate_dbinsert IS 'Fonction de mise à jour des champs dbinsert et dbupdate selon l''opération réalisée';

