comment on table r_patbat.geo_ssite is 'Classe géographique regroupant les informations de toutes les entités étant des sous-sites';
comment on column r_patbat.geo_ssite.id_entite is 'Identifiant de l''entité';


create table r_patbat.geo_bati(
