-- Calcule la somme de la surface au sol des bâtiments compris dans un sous-site 
CREATE OR REPLACE FUNCTION r_patbat.ft_r_maj_supsol_ssite(p_id_ssite INT)
RETURNS VOID AS $$
BEGIN
        UPDATE r_patbat.geo_patbat_ssite
        SET supsol_tot_bati = (
            SELECT ROUND(SUM(ST_Area(ST_Intersection(b.geom, ss.geom)))::numeric) -- On sélectionne la somme arrondie des aires d'intersection entre les bâtiments et le sous-site passé en paramètre
            FROM r_patbat.geo_patbat_bati b
            JOIN r_patbat.an_patbat_entite e ON b.id_entite = e.id_entite
            JOIN r_patbat.geo_patbat_ssite ss ON ST_Intersects(b.geom, ss.geom) -- Jointure spatiale entre la table de bâtiments et sous-site 
            WHERE ss.id_entite = p_id_ssite
            AND e.dbstatut = '10' -- que les bâtiments actifs
        )
        WHERE id_entite = p_id_ssite;
END;
$$ LANGUAGE plpgsql;

