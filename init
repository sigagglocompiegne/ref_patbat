CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_local()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_statut_uf VARCHAR; --le statut de l'uf dans laquelle se trouve le local

BEGIN
	
	SELECT dbstatut INTO v_statut_uf -- onstocke le statut de l'uf dans laquelle se trouve le local
	FROM r_patbat.an_entite 
	WHERE id_entite = NEW.id_uf;

	IF v_statut_uf is null then 
	raise exception 'L''unité fonctionnelle est introuvable';
	end if;

	-- Vérification de la cohérence des statuts, impossible de mettre un local dans un site désactivé
	IF v_statut_uf = '20' AND NEW.dbstatut != '20' THEN
		RAISE EXCEPTION 'Impossible d''insérer ou de rendre actif un local dans une unité fonctionnelle désactivée (dbstatut = 20)';
	END IF;

	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN
        INSERT INTO r_patbat.an_entite ( -- on insère les données de la vue dans la table an_entite
            type_entite,ref_code, nom_court, nom_long, superficie, surface, categorie, observ, type_etablissement, dbstatut
        )
        VALUES (
            'Local',NEW.ref_code, NEW.nom_court, NEW.nom_long, NEW.superficie, NEW.surface, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table an_local, en utilisant le même id_entite
        INSERT INTO r_patbat.an_local (id_entite, id_uf, etage)
        VALUES (nouvel_id, NEW.id_uf, NEW.etage);

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_court = NEW.nom_court,
            nom_long = NEW.nom_long,
            superficie = NEW.superficie,
			surface = NEW.surface,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.an_local -- on update la table an_local
        SET id_uf = NEW.id_uf, etage = NEW.etage
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '20' THEN -- si le local est désactivé (dbstatut = '20') alors
			DELETE FROM r_patbat.an_local WHERE id_entite = OLD.id_entite; -- delete le local de la table an_local
        	DELETE FROM r_patbat.an_entite WHERE id_entite = OLD.id_entite; -- delete le local de la table entité
		
		ELSE -- si le local est activée (dbstatut = '10')
			UPDATE r_patbat.an_entite -- on désactive le local (dbstatut = '20')
			SET dbstatut = '20' 
			WHERE id_entite = OLD.id_entite;
		END IF;
        
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_local IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et local, par des opérations directement dans ces tables';


