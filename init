CREATE OR REPLACE FUNCTION ft_r_insee_commune() 
RETURNS TRIGGER AS $$
DECLARE
    v_commune VARCHAR;
    v_insee VARCHAR;
BEGIN
    -- 1. On récupère les valeurs grâce à l'intersection spatiale
    SELECT c.tex2, '60' || c.idu
    INTO v_commune, v_insee
    FROM r_cadastre.geo_commune c
    WHERE ST_Intersects(NEW.geom, c.geom)
    LIMIT 1;

    -- 2. On met à jour la table entité avec l'ID de l'entité
    UPDATE r_patbat.an_entite
       SET commune = v_commune, insee = v_insee
       WHERE id_entite = NEW.id_entite;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION ft_r_insee_commune IS 'Fonction pour trouver le code insee et le nom de la commune de l''entité en fonction de sa géométrie présente dans les tables geo_';

