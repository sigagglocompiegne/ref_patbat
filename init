-- 1. Création de la fonction d'automatisation
CREATE OR REPLACE FUNCTION r_patbat.ft_r_liaison_adresse_auto()
RETURNS TRIGGER AS $$
BEGIN
    -- 1. Nettoyage lors d'une modification (UPDATE)
    -- Si la géométrie change, on supprime de la table lk les adresses qui ne sont plus couvertes.
    IF TG_OP = 'UPDATE' THEN
        DELETE FROM r_patbat.lk_patbat_adresse
        WHERE id_entite = NEW.id_entite
          AND id_adresse NOT IN (
              SELECT adr.id_adresse 
              FROM r_objet.geo_objet_pt_adresse pt
              JOIN r_adresse.an_adresse adr ON pt.id_adresse = adr.id_adresse
              WHERE ST_Intersects(NEW.geom, pt.geom)
          );
    END IF;

    -- 2. Ajout ou Maintien des adresses (INSERT & UPDATE)
    -- On insère automatiquement les adresses contenues dans le polygone
    INSERT INTO r_patbat.lk_patbat_adresse (id_entite, id_adresse)
    SELECT NEW.id_entite, adr.id_adresse 
    FROM r_objet.geo_objet_pt_adresse pt
    JOIN r_adresse.an_adresse adr ON pt.id_adresse = adr.id_adresse
    WHERE ST_Intersects(NEW.geom, pt.geom) AND NOT EXISTS (SELECT 1 FROM r_patbat.lk_patbat_adresse WHERE id_entite = NEW.id_entite and id_entite = NEW.id_entite); -- test si la liaison n'existe pas déja

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_r_liaison_adresse_auto IS 'Lie automatiquement les adresses géographiques (points) interceptées par l''entité saisie/modifiée';

