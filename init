CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_bati()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_id_site INT; -- l'id du site dans lequel est compris le bâtiment
	v_statut_site VARCHAR; --le statut du site dans lequel est compris le bâtiment
	v_nom_usage_site varchar; -- le nom d'usage du site dans lequel est compris le bâtiment 
	v_code_ref_site varchar; -- code de référence du site dans lequel est compris le bâtiment
	v_code_ref_id varchar; -- id du bati a utiliser dans le code_ref
	r RECORD; -- variable de boucle 
BEGIN

-----------------------------------------------------------------------------------------
--                                       CONTROLES DE SAISIE                           --
-----------------------------------------------------------------------------------------

	-- Si l'opération n'est pas un delete 
	IF TG_OP IN ('INSERT', 'UPDATE') THEN

	SELECT s.id_entite, e.dbstatut, e.nom_usage, e.ref_code INTO v_id_site, v_statut_site, v_nom_usage_site, v_code_ref_site -- on stocke l'id, le nom d'usage et le statut du site actif dans lequel est compris le bâtiment
		FROM r_patbat.geo_patbat_site s 
		JOIN r_patbat.an_patbat_entite e ON s.id_entite = e.id_entite
		WHERE ST_CoveredBy(ST_Buffer(NEW.geom,-0.1 ),s.geom) and e.dbstatut = '10';

	-- on teste si le bâtiment est bien compris dans un site 
	IF TG_OP IN ('UPDATE','INSERT') AND v_id_site IS NULL THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Le bâtiment doit être compris dans un site</b></span><br><br>';
	END IF; 

	-- Vérification de la cohérence des statuts, impossible de mettre un bâtiment actif dans un site désactivé
	IF v_statut_site = '11' AND NEW.dbstatut != '11' THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Impossible d''insérer ou de rendre actif un bâtiment dans un site désactivé (dbstatut = 11)</b></span><br><br>';
	END IF;

	-- on vérifie si le bâtiment actif ne se superpose pas avec un autre bâtiment actif
	IF EXISTS(SELECT 1 FROM r_patbat.geo_patbat_bati b 
			  JOIN r_patbat.an_patbat_entite e ON b.id_entite = e.id_entite
			  WHERE b.id_entite is distinct from NEW.id_entite 
			  AND e.dbstatut IS DISTINCT FROM '11' 
			  AND NEW.dbstatut IS DISTINCT FROM '11' 
				AND ST_Intersects(ST_Buffer(NEW.geom, -0.1), b.geom)
              and (ST_Intersects(NEW.geom,b.geom) and not ST_Touches(NEW.geom,b.geom))) THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Le bâtiment se superpose avec un autre</b></span><br><br>';
	END IF;

	-- si la supdvp est NULL mais que supdvp_mesuree set cochée alors on interdit la saisie car impossible
	IF (NEW.supdvp is null or NEW.supdvp = 0 ) AND NEW.supdvp_mesuree = True then 
		RAISE EXCEPTION '<span style="color:red;"><b>Si la surface développée est mesurée, elle ne peut être égale à 0 ou nulle</b></span><br><br>';
	end if; 

	ELSE
	-- Si l'opération est un delete, on récupère l'id site du batiment delete 
		SELECT id_site INTO v_id_site FROM r_patbat.geo_patbat_bati WHERE id_entite = OLD.id_entite;
	END IF;

-----------------------------------------------------------------------------------------
--                                    OPERATIONS                                       --
-----------------------------------------------------------------------------------------

	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN

		UPDATE r_patbat.geo_patbat_site
    	SET nb_bati = nb_bati + 1 
    	WHERE id_entite = v_id_site
    	RETURNING nb_bati INTO v_code_ref_id;

		-- si le bâtiment n'a pas de nom, on reprend le nom du site, et on y ajoute Bâtiment sans nom 
		IF NEW.nom_usage is null then 
			NEW.nom_usage := v_nom_usage_site || ' - Batiment sans nom' ;
		end if; 		

        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert
        )
        VALUES (
            'Bâtiment', v_code_ref_site || '-B' || v_code_ref_id , NEW.nom_usage, NEW.nom_officiel, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table geo_bati, en utilisant le même id_entite et le v_id_site récupéré
        INSERT INTO r_patbat.geo_patbat_bati (id_entite, geom, etat, id_site,supsol,supdvp, supdvp_mesuree,nb_etage)
        VALUES (nouvel_id, NEW.geom, NEW.etat, v_id_site,ROUND(ST_Area(NEW.geom)::numeric),NEW.supdvp, NEW.supdvp_mesuree, NEW.nb_etage);

		-- On insère le lien entre bati et site/ssite dans les tables de lien 
		INSERT INTO r_patbat.lk_patbat_site_bati (id_site, id_bati)
		VALUES (v_id_site, nouvel_id);

		INSERT INTO r_patbat.lk_patbat_ssite_bati (id_ssite, id_bati) 
		SELECT id_entite, nouvel_id 
		FROM r_patbat.geo_patbat_ssite 
		WHERE ST_Intersects(NEW.geom, geom);

		-- On lance la fonction de calcul de total surface sol des bâtimetns dans un sous-site pour tout les sous-sites dans lequel est compris le bâtiment
		FOR r IN (SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(NEW.geom, geom)) LOOP
            PERFORM r_patbat.ft_r_maj_supsol_ssite(r.id_entite); 
        END LOOP;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut, 
			op_maj = NEW.op_maj,
 			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.geo_patbat_bati -- on update la table geo_bati
        SET geom = NEW.geom, 
		etat = NEW.etat,
		supsol = ROUND(ST_Area(NEW.geom)::numeric),
		supdvp = NEW.supdvp,
		supdvp_mesuree = NEW.supdvp_mesuree,
		nb_etage = NEW.nb_etage
        WHERE id_entite = OLD.id_entite;

		-- on recalcule le total surface sol des bâtimetns dans l'ancien sous-site ou se trouvait le bâtiment, ainsi que dans le nouveau
		FOR r IN (
            SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(NEW.geom, geom)
            UNION
            SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(OLD.geom, geom)
        ) LOOP
            PERFORM r_patbat.ft_r_maj_supsol_ssite(r.id_entite); 
        END LOOP;

		-- Si on change la géométrie, alors on refait les liens avec site et ssites des batiments,uf et locaux 
		IF NEW.geom != OLD.geom THEN
			-- 1. On détruit tous les liens du Bâtiment vers le HAUT (Site et SSite)
			DELETE FROM r_patbat.lk_patbat_site_bati WHERE id_bati = NEW.id_entite;
			DELETE FROM r_patbat.lk_patbat_ssite_bati WHERE id_bati = NEW.id_entite;
			
			-- 2. On détruit les liens des enfants (UFs et Locaux) vers le HAUT (Site et SSite)
			-- on récupère les id_entite des uf qui ont pour id_bati le batiment qu'on vient de modifier et on supprime leurs lien avec site et ssite
			DELETE FROM r_patbat.lk_patbat_site_uf WHERE id_uf IN (SELECT id_entite FROM r_patbat.an_patbat_unite_fonc WHERE id_bati = NEW.id_entite);
			DELETE FROM r_patbat.lk_patbat_ssite_uf WHERE id_uf IN (SELECT id_entite FROM r_patbat.an_patbat_unite_fonc WHERE id_bati = NEW.id_entite);
			
			-- on récupère les id_entite des locaux qui ont pour id_uf, une uf compris dans le bâtiment qu'on vient de modifier, et on supprime leurs lien avec site et ssite
			DELETE FROM r_patbat.lk_patbat_site_local WHERE id_local IN (SELECT l.id_entite FROM r_patbat.an_patbat_local l JOIN r_patbat.an_patbat_unite_fonc uf ON l.id_uf = uf.id_entite WHERE uf.id_bati = NEW.id_entite);
			DELETE FROM r_patbat.lk_patbat_ssite_local WHERE id_local IN (SELECT l.id_entite FROM r_patbat.an_patbat_local l JOIN r_patbat.an_patbat_unite_fonc uf ON l.id_uf = uf.id_entite WHERE uf.id_bati = NEW.id_entite);

			-- 3. On recrée les liens Bâtiment
			-- on récupère l'id_site dans lequel est le bâtiment, et on crée le lien entre ce site et le bâtiment qu'on vient de modifier
			INSERT INTO r_patbat.lk_patbat_site_bati (id_site, id_bati) 
			SELECT id_entite, NEW.id_entite FROM r_patbat.geo_patbat_site WHERE ST_Intersects(NEW.geom, geom);
			
			-- on récupère l'(les) id_ssite dans lequel est le bâtiment, et on crée le(s) lien(s) entre ce(s) ssite et le bâtiment qu'on vient de modifier 
			INSERT INTO r_patbat.lk_patbat_ssite_bati (id_ssite, id_bati)
			SELECT id_entite, NEW.id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(NEW.geom, geom);

			-- 4. On recrée les liens UF
			-- on récupère les id_entite des uf compris dans le site qu'on vient de modifer, et on crée le lien entre elle et le site dans lequel est compris le bâtiment
			INSERT INTO r_patbat.lk_patbat_site_uf (id_site, id_uf)
			SELECT v_id_site, id_entite FROM r_patbat.an_patbat_unite_fonc WHERE id_bati = NEW.id_entite;
			
			-- pour chaque lien qu'il existe entre le bâtiment qu'on vient de modifier et un ssite, on crée un lien entre ce ssite et les uf comprises dans le bâtiment modifié
			INSERT INTO r_patbat.lk_patbat_ssite_uf (id_ssite, id_uf)
			SELECT lk.id_ssite, uf.id_entite 
			FROM r_patbat.lk_patbat_ssite_bati lk
			JOIN r_patbat.an_patbat_unite_fonc uf ON uf.id_bati = lk.id_bati
			WHERE lk.id_bati = NEW.id_entite;

			-- 5. On recrée les liens Local
			-- on récupère les locaux présents dans les uf du bâtiment qu'on vient de modifier, et on crée un lien entre ces locaux et le site dans lequel est le bâtiment
			INSERT INTO r_patbat.lk_patbat_site_local (id_site, id_local)
			SELECT v_id_site, l.id_entite 
			FROM r_patbat.an_patbat_local l 
			JOIN r_patbat.an_patbat_unite_fonc uf ON l.id_uf = uf.id_entite 
			WHERE uf.id_bati = NEW.id_entite;

			-- pour chaque lien qu'il existe entre le bâtiment dans lequel est compris le local et un ssite, on crée un lien entre le local et ce ssite
			INSERT INTO r_patbat.lk_patbat_ssite_local (id_ssite, id_local)
			SELECT lk.id_ssite, l.id_entite 
			FROM r_patbat.lk_patbat_ssite_bati lk
			JOIN r_patbat.an_patbat_unite_fonc uf ON uf.id_bati = lk.id_bati
			JOIN r_patbat.an_patbat_local l ON l.id_uf = uf.id_entite
			WHERE lk.id_bati = NEW.id_entite;
		END IF;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '11' THEN -- si le bâtiment est désactivé (dbstatut = '11') alors
			DELETE FROM r_patbat.geo_patbat_bati WHERE id_entite = OLD.id_entite; -- delete le bâtiment de la table geo_bati
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete le bâtiment de la table entité
		
		ELSE -- si le bâtiment est activé (dbstatut = '10')
			UPDATE r_patbat.an_patbat_entite -- on désactive le bâtiment (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;

		--on recalcule le total surface sol des bâtimetns dans l'ancien sous-site ou se trouvait le bâtiment 
		FOR r IN (SELECT id_entite FROM r_patbat.geo_patbat_ssite WHERE ST_Intersects(OLD.geom, geom)) LOOP
            PERFORM r_patbat.ft_r_maj_supsol_ssite(r.id_entite);
        END LOOP;
    END IF;


	-- mise à jour de la supsol  du site, en additionnant les supsols des bâitments actifs compris dans le site
		UPDATE r_patbat.geo_patbat_site
		SET supsol_tot_bati = (
			SELECT SUM(b.supsol) 
			FROM r_patbat.geo_patbat_bati b 
			JOIN r_patbat.an_patbat_entite e ON b.id_entite = e.id_entite 
			WHERE b.id_site = v_id_site AND e.dbstatut = '10'
		)
		WHERE id_entite = v_id_site;

	-- si il existe un batiment compris dans le site, qui a une superficie nullle ou = a 0, alors on met le total superficie dvp du site à 0 
		IF exists( select 1 from r_patbat.geo_patbat_bati b -- un bâtiment actif compris dans le site avec une superficie dvp non mesurée
					join r_patbat.an_patbat_entite e on e.id_entite = b.id_entite 
					where b.id_site = v_id_site and e.dbstatut = '10' and (b.supdvp is null or b.supdvp = 0) 
				 ) THEN 
			-- on met le total supdvp bati du site à 0 
			UPDATE r_patbat.geo_patbat_site  
			SET supdvp_tot_bati = NULL, supdvp_tot_mesuree = False
			WHERE id_entite = v_id_site ;

		else -- sinon, on additionne la supdvp des bâtiments compris dans le site, si tout les bâtiments ont une surface mesurée, alors on dit que supdpv_tot_bati est mesurée (pour le site)




			-- tout les batis ont une surface dvp mesurée -> on cacule le total des supdvp et on la met dans le site
			UPDATE r_patbat.geo_patbat_site
			-- calcul de la superficie
			SET supdvp_tot_bati = (
				SELECT SUM(b.supdvp)
				from r_patbat.geo_patbat_bati b
				join r_patbat.an_patbat_entite e on e.id_entite = b.id_entite
				where b.id_site = v_id_site and e.dbstatut = '10')
			-- test surface mesurée, on teste si il existe un bâtiment compris dans le site avec une surface non mesurée
			,supdvp_tot_mesuree = (NOT EXISTS(SELECT 1 
			FROM r_patbat.geo_patbat_bati b
			JOIN r_patbat.an_patbat_entite e ON e.id_entite = b.id_entite
			WHERE e.dbstatut = '10' AND b.id_site = v_id_site and b.supdvp_mesuree = 'False'))

			where id_entite = v_id_site;
			end if; 

		IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    ELSE
        RETURN NEW;
    END IF;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_bati IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et bâtiment, par des opérations directement dans ces tables';

CREATE or replace TRIGGER t_t1_gestion_v_bati
INSTEAD OF INSERT OR UPDATE OR DELETE ON r_patbat.geo_v_patbat_bati
FOR EACH ROW EXECUTE FUNCTION r_patbat.ft_m_gestion_v_bati();

COMMENT ON TRIGGER t_t1_gestion_v_bati ON r_patbat.geo_v_patbat_bati IS 'Trigger se déclanchant a l''insert, update, ou delete de la vue de regroupement de données entre les tables entité et bâtiment, appelant la fonction pour réaliser ces opérations directement dans les tables ';  

 
