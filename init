create or replace view r_patbat.an_v_patbat_unite_fonc as 
	select e.ref_code,
	e.id_entite,
	e.nom_usage,
	e.nom_officiel,
	uf.supdvp,
	uf.supdvp_mesuree,
	e.categorie,
	e.observ,
	e.type_etablissement,
	e.dbstatut,
	uf.id_bati,
	e.op_sai,
	e.op_maj,
	e.dbinsert,
	e.dbupdate
	from r_patbat.an_patbat_entite e
 	join r_patbat.an_patbat_unite_fonc uf on e.id_entite = uf.id_entite;

COMMENT ON VIEW r_patbat.an_v_patbat_unite_fonc IS 'Vue regroupant les attributs de la table entité ainsi que ceux de la table d''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.ref_code IS 'Code de référence de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.id_entite IS 'Identifiant entité de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.nom_usage IS 'Nom d''usage de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.nom_officiel IS 'Nom officiel de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.supdvp IS 'Superficie développée (ou de plancher) de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.supdvp_mesuree IS 'Est-ce que la superficie développée de l''unité fonctionnelle est mesurée (sûre)';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.categorie IS 'Catégorie principale de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.observ IS 'Commentaires divers sur l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.type_etablissement IS 'Types d''établissements de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.dbstatut IS 'Statut de l''unité fonctionnelle (actif ou désactivé)';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.id_bati IS 'Identifiant du bâtiment auquel appartient l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.op_sai IS 'Login de la personne ayant saisi l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.op_maj IS 'Login de la personne ayant modifié l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.dbinsert IS 'Date d''insertion de l''unité fonctionnelle';
COMMENT ON COLUMN r_patbat.an_v_patbat_unite_fonc.dbupdate IS 'Date de mise à jour de l''unité fonctionnelle';

CREATE OR REPLACE FUNCTION r_patbat.ft_m_gestion_v_unite_fonc()
RETURNS TRIGGER AS $$
DECLARE
    nouvel_id INT; --variable dans laquelle on va stocker l'id_entite qu'on crée
	v_statut_bati VARCHAR; -- l'id du bâtiment dans lequel se trouve l'UF
	v_nom_bati varchar; -- le nom court du bâti dans lequel se trouve l'unité fonctionnelle
	v_insee_bati varchar; --le code insee du bâti dans lequel se trouve l'unité fonctionnelle
	v_commune_bati varchar; -- le nom de la commune du bâti dans lequel se trouve l'unité fonctionnelle 
	v_code_ref_bati varchar; -- le code de référence du bâti dans lequel se trouve l'uf
	v_code_ref_id varchar; --l'id de l'uf a utilser dans le code ref
BEGIN
	
-----------------------------------------------------------------------------------------
--                                       CONTROLES DE SAISIE                           --
-----------------------------------------------------------------------------------------

	SELECT dbstatut, nom_usage, insee, commune, ref_code INTO v_statut_bati, v_nom_bati, v_insee_bati, v_commune_bati, v_code_ref_bati -- on va chercher le statut et le nom du bâtiment dans lequel se trouve l'unité fonctionnelle
	FROM r_patbat.an_patbat_entite 
	WHERE id_entite = NEW.id_bati;

	-- sécurité bâtiment
	IF TG_OP IN ('UPDATE','INSERT') and v_statut_bati is null then 
	raise exception '<span style="color:red;"><b>Erreur : Le bâtiment est introuvable ou pas encore créé</b></span><br><br>';
	end if; 

	-- Vérification de la cohérence des statuts, impossible de mettre une UF active dans un site désactivé
	IF v_statut_bati = '11' AND NEW.dbstatut != '11' THEN
		RAISE EXCEPTION '<span style="color:red;"><b>Impossible d''insérer ou de rendre actif une unité fonctionnelle dans un site désactivé (dbstatut = 11)</b></span><br><br>';
	END IF;

	-- si l'UF n'a pas de nom, alors on utilse le nom du bâtiment auquel on y rajouter Unité fonctionnelle sans nom
	IF NEW.nom_usage is null then
		NEW.nom_usage := v_nom_bati || ' - Unité fonctionnelle sans nom';
	end if;  
	
	-- si la supdvp est NULL mais que supdvp_mesuree set cochée alors on interdit la saisie car impossible
	IF (NEW.supdvp is null or NEW.supdvp = 0 ) AND NEW.supdvp_mesuree = True then 
		RAISE EXCEPTION '<span style="color:red;"><b>Si la surface développée est mesurée, elle ne peut être égale à 0 ou nulle</b></span><br><br>';
	end if; 

-----------------------------------------------------------------------------------------
--                                    OPERATIONS                                       --
-----------------------------------------------------------------------------------------

	
	-- si l'opération réalisée sur la vue est un INSERT
    IF TG_OP = 'INSERT' THEN

		UPDATE r_patbat.geo_patbat_bati
    	SET nb_uf = nb_uf + 1
    	WHERE id_entite = NEW.id_bati
   	 	RETURNING nb_uf INTO v_code_ref_id;

        INSERT INTO r_patbat.an_patbat_entite ( -- on insère les données de la vue dans la table an_entite
            niveau,ref_code, nom_usage, nom_officiel, categorie, observ, type_etablissement, dbstatut, op_sai, dbinsert, insee, commune 
        )
        VALUES (
            'Unité', v_code_ref_bati || '-UF' || v_code_ref_id , NEW.nom_usage, NEW.nom_officiel, NEW.categorie, NEW.observ, NEW.type_etablissement, NEW.dbstatut, NEW.op_sai, CURRENT_TIMESTAMP, v_insee_bati, v_commune_bati
        )
        RETURNING id_entite INTO nouvel_id; -- on stocke l'id qu'on vient de créer dans la variable nouvel_id

		-- On insère les données dans la table an_unite_fonc, en utilisant le même id_entite
        INSERT INTO r_patbat.an_patbat_unite_fonc (id_entite, id_bati, supdvp, supdvp_mesuree)
        VALUES (nouvel_id, NEW.id_bati, NEW.supdvp, NEW.supdvp_mesuree);

		-- On insère le lien entre UF et bati/ssite/site dans les tables de lien 
		-- 1. Lien direct : Bâtiment <-> UF
		INSERT INTO r_patbat.lk_patbat_bati_uf (id_bati, id_uf)
		VALUES (NEW.id_bati, nouvel_id);

		-- 2. Lien hérité : Site <-> UF
		-- On va chercher l'id_site directement dans la table de liaison du bâtiment parent
		INSERT INTO r_patbat.lk_patbat_site_uf (id_site, id_uf)
		SELECT id_site, nouvel_id 
		FROM r_patbat.lk_patbat_site_bati 
		WHERE id_bati = NEW.id_bati;

		-- 3. Lien hérité : Sous-site(s) <-> UF
		INSERT INTO r_patbat.lk_patbat_ssite_uf (id_ssite, id_uf)
		SELECT id_ssite, nouvel_id 
		FROM r_patbat.lk_patbat_ssite_bati 
		WHERE id_bati = NEW.id_bati;

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un UPDATE
    ELSIF TG_OP = 'UPDATE' THEN
        UPDATE r_patbat.an_patbat_entite -- on update la table an_entite
        SET ref_code = NEW.ref_code,
            nom_usage = NEW.nom_usage,
            nom_officiel = NEW.nom_officiel,
            categorie = NEW.categorie,
            observ = NEW.observ,
			type_etablissement = NEW.type_etablissement,
			dbstatut = NEW.dbstatut,
 			op_maj = NEW.op_maj, 
			dbupdate = CURRENT_TIMESTAMP
        WHERE id_entite = OLD.id_entite;

        UPDATE r_patbat.an_patbat_unite_fonc -- on update la table an_unite_fonc
        SET id_bati = NEW.id_bati,
		supdvp = NEW.supdvp,
		supdvp_mesuree = NEW.supdvp_mesuree
        WHERE id_entite = OLD.id_entite;

        RETURN NEW;

	-- si l'opération réalisée sur la vue est un DELETE
    ELSIF TG_OP = 'DELETE' THEN
		
		IF OLD.dbstatut = '11' THEN -- si l'unité fonctionnelle est désactivée (dbstatut = '11') alors
			DELETE FROM r_patbat.an_patbat_unite_fonc WHERE id_entite = OLD.id_entite; -- delete l'unité fonctionnelle de la table an_unite_fonc
        	DELETE FROM r_patbat.an_patbat_entite WHERE id_entite = OLD.id_entite; -- delete l'unité fonctionnelle de la table entité
		
		ELSE -- si l'unité fonctionnelle est activée (dbstatut = '10')
			UPDATE r_patbat.an_patbat_entite -- on désactive l'unité fonctionnelle (dbstatut = '11')
			SET dbstatut = '11' 
			WHERE id_entite = OLD.id_entite;
		END IF;
        
        RETURN OLD;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION r_patbat.ft_m_gestion_v_unite_fonc IS 'Fonction qui transforme les opérations passées dans la vue de regroupement de données entre les tables entité et unité fonctionnelle, par des opérations directement dans ces tables';


