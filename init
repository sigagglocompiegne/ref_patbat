comment on column r_patbat.geo_patbat_bati.etat is 'Etat du bâtiment';
comment on column r_patbat.geo_patbat_bati.geom is 'Géométrie du bâtiment';
comment on column r_patbat.geo_patbat_bati.supsol is 'Superficie au sol du bâtiment, champ calculé auto à l''insert ';
comment on column r_patbat.geo_patbat_bati.supdvp is 'Superficie développée du bâtiment';
