CREATE OR REPLACE FUNCTION ft_r_parcelles()
RETURNS TRIGGER AS $$
BEGIN
    -- Mise à jour de la table entité avec un tableau contenant toutes les parcelles intersectées
    UPDATE r_patbat.an_entite  
    SET parcelles = ARRAY( -- tableau contenant les parcelles sur lesquelles se trouvent l'entité 
        SELECT geo_parcelle 
        FROM r_cadastre.geo_parcelle p 
        WHERE ST_Intersects(NEW.geom, p.geom)
    )
    WHERE id_entite = NEW.id_entite;
    
    RETURN NEW; 
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION ft_r_parcelles IS 'Fonction récupérant un tableau contenant les numéros de parcelles cadastrales dans lesquelles se trouvent l''entité';

